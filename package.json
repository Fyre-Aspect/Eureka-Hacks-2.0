{
  "name": "lingualens",
  "private": true,
  "workspaces": [
    "extension",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=extension\" \"npm run server:dev --workspace=server\"",
    "lint": "eslint extension/src server/src --ext .ts,.tsx",
    "typecheck": "tsc -b extension server"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
